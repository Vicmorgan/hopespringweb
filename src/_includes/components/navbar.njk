<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[60] bg-white dark:bg-background-dark transform translate-x-full transition-transform duration-300 md:hidden flex flex-col">
    <div class="flex items-center justify-between p-6 border-b border-[#f4f3f0] dark:border-[#3a3528]">
        <a href="/" class="flex items-center gap-3">
            <img src="/assets/images/logo.png" alt="Hopespring Foundation Logo" class="h-10 w-auto">
        </a>
        <button id="close-menu-btn" class="p-2 text-[#181611] dark:text-white hover:text-primary transition-colors focus:outline-none">
            <span class="material-symbols-outlined text-3xl">close</span>
        </button>
    </div>
    <div class="flex flex-col p-6 gap-6 overflow-y-auto">
        <a class="text-xl transition-colors {% if page.fileSlug == '' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/">Home</a>
        <a class="text-xl transition-colors {% if page.fileSlug == 'about' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/about/">About</a>
        <a class="text-xl transition-colors {% if page.fileSlug == 'academics' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/academics/">Academics</a>
        <a class="text-xl transition-colors {% if page.fileSlug == 'parents' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/parents/">Parents</a>
        <a class="text-xl transition-colors {% if page.fileSlug == 'admission' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/admission/">Admissions</a>
        <a class="text-xl transition-colors {% if page.fileSlug == 'gallery' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/gallery/">Gallery</a>
        
        <div class="mt-4 pt-4 border-t border-[#f4f3f0] dark:border-[#3a3528] flex flex-col gap-4">
            <a href="/start_application/" class="flex w-full items-center justify-center rounded-xl h-12 bg-primary text-[#181611] text-lg font-bold shadow-sm hover:brightness-105 transition-all">
                Enroll Now
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('close-menu-btn');
        const menu = document.getElementById('mobile-menu');

        if (btn && closeBtn && menu) {
            btn.addEventListener('click', () => {
                menu.classList.remove('translate-x-full');
            });

            closeBtn.addEventListener('click', () => {
                menu.classList.add('translate-x-full');
            });
        }
    });
</script>
