                    <a class="text-sm leading-normal transition-colors {% if page.fileSlug == 'activities' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/activities/">Activities</a>
                    <a class="text-sm leading-normal transition-colors {% if page.fileSlug == 'parents' %}text-primary font-bold{% else %}font-medium hover:text-primary{% endif %}" href="/parents/">Parents</a>
