<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script>
        (function () {
            var stored = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (stored === 'dark' || (!stored && prefersDark)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <title>{{ title | default("Hopespring Foundation") }}</title>
    <meta name="description" content="{{ description | default("Welcome to Hopespring Foundation School") }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title | default(site.name) }}" />
    <meta property="og:description" content="{{ description | default('Welcome to Hopespring Foundation School') }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}{{ image | default(site.defaultImage) }}" />
    <meta property="og:locale" content="en_NG" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title | default(site.name) }}" />
    <meta name="twitter:description" content="{{ description | default('Welcome to Hopespring Foundation School') }}" />
    <meta name="twitter:image" content="{{ site.url }}{{ image | default(site.defaultImage) }}" />

    <meta name="theme-color" content="#eebd2b" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="/assets/css/style.css" rel="stylesheet" />

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "School",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}",
        "logo": "{{ site.url }}/assets/images/logo.png",
        "telephone": "{{ site.phone }}",
        "email": "{{ site.email }}",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "{{ site.address.street }}",
            "addressLocality": "{{ site.address.locality }}",
            "addressRegion": "{{ site.address.region }}",
            "postalCode": "{{ site.address.postalCode }}",
            "addressCountry": "{{ site.address.country }}"
        }
    }
    </script>
</head>
